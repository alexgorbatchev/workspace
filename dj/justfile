set dotenv-load := false

default:
    @just --list

# Show status across submodules in this bucket
status:
    bash ../scripts/bucket.sh status

# Synchronize and fast-forward all submodules in this bucket
sync:
    bash ../scripts/bucket.sh sync

# Align submodules to configured branches or an explicit override
[positional-arguments]
align branch="":
    #!/usr/bin/env bash
    set -euo pipefail
    bash ../scripts/bucket.sh align "$1"

# Run checks across submodules in this bucket
check:
    bash ../scripts/bucket.sh check

# Run unit tests across submodules in this bucket
test:
    bash ../scripts/bucket.sh test

# Clean build artifacts across submodules in this bucket
clean:
    bash ../scripts/bucket.sh clean
